# Defaults when not specified:
#   IP_ADDRESS -> 127.0.0.1
#   PORT       -> 50052

IP_ADDRESS="0.0.0.0"
PORT="50052"

# Add only when set:
SERVER_UUID=""

# TLS handling
# - When ENABLE_TLS=FALSE, the SiLA Server start with "--insecure" option.
# - When ENABLE_TLS=TRUE and CERT_FILE is set, use the specified certification file.
# - When ENABLE_TLS=TRUE and PRIVATE_KEY is set, use the private key.
#
# Note: CERT_FILE and PRIVATE_KEY must be either BOTH set or BOTH unset.
# 
ENABLE_TLS="TRUE"
CERT_FILE=""
PRIVATE_KEY=""
